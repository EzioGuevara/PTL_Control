<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PTLControl.App</AssemblyName>
    <RootNamespace>PTLControl</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTLControl.Compat\PTLControl.Compat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="idemia.png" />
  </ItemGroup>

</Project>
