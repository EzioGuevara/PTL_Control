<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PTLControl.Compat</RootNamespace>
    <AssemblyName>PTLControl.Compat</AssemblyName>
    <Description>PTL LED Matrix Control - compatible library for .NET Framework 4.7.2+ consumers (C#/VB.NET)</Description>
  </PropertyGroup>

  <!-- netstandard2.0 需要 NuGet 版串口包；net472 内置了，不引用 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.IO.Ports" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.2.1.781" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
